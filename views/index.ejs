<%- include('partials/header') %>

<main class="container my-5">

    <section class="text-center py-5">
        <h1 class="display-4">Welcome to My Portfolio!</h1>

        <h2 class="mt-3">Hi, I'm Jovitha.</h2>

        <p class="lead mt-3">
            I am a Bachelor of Information Technology student majoring in
            Networking and IT Security at Ontario Tech University.
        </p>

        <p class="mt-3">
            Welcome to my portfolio! This website showcases my academic
            background, technical skills, and projects that I have worked
            on throughout my learning journey.
        </p>

        <a href="/about" class="btn btn-primary mt-3">
            Learn More About Me
        </a>
    </section>

    <section class="row text-center mt-4">

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <i class="fas fa-user fa-2x mb-3"></i>
                    <h3 class="card-title">About Me</h3>
                    <p class="card-text">
                        Learn about my academic background, interests,
                        and skills.
                    </p>
                    <a href="/about" class="btn btn-outline-primary">
                        About Me
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <i class="fas fa-laptop-code fa-2x mb-3"></i>
                    <h3 class="card-title">My Projects</h3>
                    <p class="card-text">
                        Explore five projects related to programming,
                        networking, and cybersecurity.
                    </p>
                    <a href="/projects" class="btn btn-outline-primary">
                        View Projects
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <i class="fas fa-envelope fa-2x mb-3"></i>
                    <h3 class="card-title">Contact Me</h3>
                    <p class="card-text">
                        Get in touch with me through my contact page.
                    </p>
                    <a href="/contact" class="btn btn-outline-primary">
                        Contact Me
                    </a>
                </div>
            </div>
        </div>

    </section>

</main>

<%- include('partials/footer') %>
